          "BTTShortcutScope": 0,
          "BTTAutoAdaptToKeyboardLayout": 0,
          "BTTActionsToExecute": [
            {
              "BTTPredefinedActionType": 206,
              "BTTShellTaskActionConfig": "/bin/bash:::-c:::-:::",
              "BTTShellTaskActionScript": "state_file=\"${TMPDIR:-/tmp}/bettertouchtool-caffeinate-${UID}.pid\"\nif [[ -r \"$state_file\" ]] && read -r caffeine_pid < \"$state_file\" && kill -0 \"$caffeine_pid\" 2>/dev/null; then\n  kill \"$caffeine_pid\"\n  rm -f \"$state_file\"\n  osascript -e 'display notification \"Sleep enabled\" with title \"BetterTouchTool\"'\nelse\n  caffeinate -dimsu &\n  printf '%s\\n' \"$!\" > \"$state_file\"\n  osascript -e 'display notification \"Sleep disabled\" with title \"BetterTouchTool\"'\nfi"
            }
          ]
        },
