#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
repo_dir="$(cd -P -- "$(dirname -- "$script_path")/.." && pwd)"
generator="$repo_dir/.bettertouchtool/generate-preset.mjs"
preset="$repo_dir/.bettertouchtool/dotfiles-unified.bttpreset"
indicator_source="$repo_dir/.bettertouchtool/caffeinate-indicator.swift"
indicator_binary="$repo_dir/.bettertouchtool/caffeinate-indicator"
bttcli="/Applications/BetterTouchTool.app/Contents/SharedSupport/bin/bttcli"
socket="/tmp/com.hegenberg.BetterTouchTool.sock"
legacy_autoload="$HOME/.btt_autoload_preset.json"

node "$generator"

if [[ ! -x "$indicator_binary" ]] || [[ "$indicator_source" -nt "$indicator_binary" ]]; then
  /usr/bin/swiftc -O "$indicator_source" -o "$indicator_binary"
fi

if [[ "${1:-}" == "--generate-only" ]]; then
  exit 0
fi

if [[ -L "$legacy_autoload" ]] &&
   [[ "$(readlink "$legacy_autoload")" == "$repo_dir/.btt_autoload_preset.json" ]]; then
  unlink "$legacy_autoload"
fi

if [[ ! -x "$bttcli" ]]; then
  echo "BetterTouchTool is not installed at /Applications/BetterTouchTool.app" >&2
  exit 1
fi

if [[ ! -S "$socket" ]]; then
  cat >&2 <<'EOF'
Enable BetterTouchTool Settings → Scripting BTT → Command Line, then restart
BetterTouchTool. After that this command will replace the existing preset in
place; no manual deletion or BetterTouchTool restart is required.
EOF
  exit 1
fi

"$bttcli" import_preset path="$preset" replaceExisting=true

caffeinate_label="com.mnewt.bettertouchtool.caffeinate"
indicator_label="com.mnewt.bettertouchtool.caffeinate-indicator"
if /bin/launchctl print "gui/${UID}/$caffeinate_label" >/dev/null 2>&1; then
  /bin/launchctl remove "$indicator_label" >/dev/null 2>&1 || true
  /bin/launchctl submit -l "$indicator_label" -- "$indicator_binary"
else
  /bin/launchctl remove "$indicator_label" >/dev/null 2>&1 || true
fi
